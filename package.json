{
  "name": "fieldops-platform",
  "version": "0.1.0",
  "description": "HVAC field operations backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev:pwa": "vite frontend/pwa --config frontend/pwa/vite.config.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "db:schema": "psql $DATABASE_URL -f src/db/schema.sql",
    "db:migrate": "psql $DATABASE_URL -f src/db/migrations/001_invite_codes.sql",
    "db:migrate2": "psql $DATABASE_URL -f src/db/migrations/002_visits_updated_at_deferred.sql",
    "db:migrate025": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/migrations/025_completion_submissions_one_per_visit.sql",
    "db:seed:catalog": "node src/db/seed/catalog.js",
    "db:seed:roles": "node src/db/seed/roles.js",
    "db:migrate026": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/migrations/026_username_password_auth.sql"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "multer": "^2.2.0",
    "pg": "^8.13.3",
    "piexifjs": "^1.0.6"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.0.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.0"
  }
}
