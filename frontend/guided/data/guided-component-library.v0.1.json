      "terminals": {
        "iCOM": {
          "fn": "Zone input · COM",
          "desc": "From the zone controller damper C.",
          "exp": "0 V reference",
          "src": "DAPC manual"
        },
        "iPC": {
          "fn": "Zone input · PC",
          "desc": "From the zone controller PC: close command.",
          "exp": "24 VAC to COM on close command",
          "src": "DAPC manual"
        },
        "iPO": {
          "fn": "Zone input · PO",
          "desc": "From the zone controller PO: open command.",
          "exp": "24 VAC to COM on open command",
          "src": "DAPC manual"
        },
        "oCOM": {
          "fn": "Zone output · COM",
          "desc": "To damper COM (1).",
          "exp": "0 V reference",
          "src": "DAPC manual"
        },
        "oPC": {
          "fn": "Zone output · PC",
          "desc": "To damper PC (6). Follows the close command unless static pressure is too high.",
          "exp": "24 VAC to COM while closing",
          "src": "DAPC manual"
        },
        "oPO": {
          "fn": "Zone output · PO",
          "desc": "To damper PO (4). Can drive a closed zone partly open (\"float\") when static pressure exceeds set-point.",
          "exp": "24 VAC to COM while opening / floating",
          "src": "DAPC manual"
        },
        "R": {
          "fn": "24 VAC in",
          "desc": "From the zone controller T'FORMER R (shared dedicated transformer).",
          "exp": "24 VAC (to C)",
          "src": "DAPC manual"
        },
        "C": {
          "fn": "Common in",
          "desc": "From the zone controller T'FORMER C.",
          "exp": "0 V reference",
          "src": "DAPC manual"
        },
        "Rb": {
          "fn": "R (same screw)",
          "desc": "Same R screw feeds the SBD2 terminal 2 (+). Two wires on one screw.",
          "exp": "24 VAC (to C)",
          "src": "field practice"
        },
        "Cb": {
          "fn": "C (same screw)",
          "desc": "Same C screw feeds the SBD2 terminal 1 (−). Two wires on one screw.",
          "exp": "0 V reference",
          "src": "field practice"
        },
        "SUP": {
          "fn": "Supply pressure port",
          "desc": "Tube to the supply plenum tap.",
          "exp": "Static pressure",
          "src": "DAPC manual"
        },
        "RET": {
          "fn": "Return pressure port",
          "desc": "Tube to the return plenum tap.",
          "exp": "Static pressure",
          "src": "DAPC manual"
        },
        "DATA": {
          "fn": "Serial data",
          "desc": "Damper position input for NCM-3z / BMPlus-3z. Not used with UT3000.",
          "exp": "Not used",
          "src": "DAPC manual"
        }
      },
      "parts": [
        {
          "id": "btn",
