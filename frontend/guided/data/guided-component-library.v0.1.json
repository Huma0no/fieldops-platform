    "dapc": {
      "name": "DAPC",
      "maker": "EWC Controls",
      "kind": "static-pressure-controller",
      "status": "ok",
      "src": "DAPC manual",
      "spec": {
        "power": "24 VAC, 3.5 VA; shared transformer 40–75 VA (limited to 60 VA by UT3000)",
        "setpoint": "0.5\" wc default (0.15–1.50)",
        "mounting": "Return duct or stud; never on supply duct or in return air stream",
        "wiring": "18 AWG solid copper multi-conductor"
