{
  "version": "0.1",
  "date": "2026-11-14",
  "note": "FieldOps component fichas — content source of truth for Guided/Explore (data, not code).",
  "components": {
    "ut3000": {
      "name": "UT3000",
      "maker": "EWC Controls",
      "kind": "zone-control",
      "status": "ok",
      "src": "UT3000 manual",
      "spec": {
        "zones": "up to 3",
        "power": "Dedicated 24 VAC transformer, 40 VA min / 60 VA max",
        "breaker": "2.5 A auto-reset on 24 VAC input",
        "damperLoad": "26 mA per damper, max 3 per zone; 100 mA auto-reset protection per damper block",
        "wiring": "18 AWG solid copper, color-coded multi-conductor. Daisy-chain UT3000 → indoor → CAPE coil → outdoor. Outdoor runs ≥ 75–100 ft or noisy: 18/4, two wires per data circuit."
      },
      "blocks": {
        "comm": {
          "title": "ZONE n · COMM T-STAT",
          "terminals": {
            "1": {
              "fn": "Data 1",
              "desc": "Thermostat communication line 1.",
              "exp": "0.6 VDC between 1 and 2",
              "src": "Daikin One Touch guide"
            },
            "2": {
              "fn": "Data 2",
              "desc": "Thermostat communication line 2.",
              "exp": "0.6 VDC between 1 and 2",
              "src": "Daikin One Touch guide"
            },
            "C": {
              "fn": "Common",
              "desc": "24 VAC return for the communicating thermostat.",
              "exp": "0 V reference",
              "src": "UT3000 manual"
            },
            "R": {
              "fn": "24 VAC power",
              "desc": "Powers the communicating thermostat.",
              "exp": "24 VAC (to C)",
              "src": "UT3000 manual"
            }
          }
        },
        "conv": {
          "title": "ZONE n · CONVENTIONAL",
          "unusedIn": [
            "communicating"
          ],
          "terminals": {
            "_": {
              "fn": "Conventional zone input",
              "desc": "For a non-communicating thermostat. Call signal referenced to C. Not used in this setup.",
              "exp": "24 VAC on call",
              "src": "UT3000 manual"
            }
          }
        },
        "damper": {
          "title": "DAMPER n",
          "terminals": {
            "C": {
              "fn": "Damper common",
              "desc": "Up to 3 dampers per zone (26 mA each). 100 mA auto-reset protection per damper block.",
              "exp": "0 V reference",
              "src": "UT3000 manual"
            },
            "PO": {
              "fn": "Power Open",
              "desc": "Energized to drive the damper open.",
              "exp": "24 VAC to C while opening",
              "src": "UT3000 manual"
            },
            "PC": {
              "fn": "Power Close",
              "desc": "Energized to drive the damper closed.",
              "exp": "24 VAC to C while closing",
              "src": "UT3000 manual"
            }
          }
        },
        "xfmr": {
          "title": "24 VAC T'FORMER",
          "terminals": {
            "R": {
              "fn": "Transformer R",
              "desc": "24 VAC input from a dedicated 40–60 VA transformer. Protected by the 2.5 A breaker. Also feeds the DAPC when installed.",
              "exp": "24 VAC (to C)",
              "src": "UT3000 manual"
            },
            "C": {
              "fn": "Transformer C",
              "desc": "24 VAC common from the transformer.",
              "exp": "0 V reference",
              "src": "UT3000 manual"
            }
          }
        },
        "iaq": {
          "title": "IAQ RELAY",
          "terminals": {
            "_": {
              "fn": "IAQ dry relay (SPDT)",
              "desc": "Dry contacts for fresh-air damper, humidifier or ERV. Energizes only with a Fan, Heat or Cool demand. Board supplies no voltage here.",
              "exp": "No voltage from board",
              "src": "UT3000 manual"
            }
          }
        },
        "sys": {
          "title": "SYSTEM · CONVENTIONAL",
          "unusedIn": [
            "communicating"
          ],
          "terminals": {
            "_": {
              "fn": "Conventional system output",
              "desc": "Call outputs to non-communicating equipment. Not used in this setup.",
              "exp": "24 VAC on call",
              "src": "UT3000 manual"
            },
            "RH": {
              "fn": "RH",
              "desc": "24 VAC in, heating side. Linked to RC by the RC/RH jumper.",
              "exp": "24 VAC (to C)",
              "src": "UT3000 manual"
            },
            "RC": {
              "fn": "RC",
              "desc": "24 VAC in, cooling side. Linked to RH by the RC/RH jumper.",
              "exp": "24 VAC (to C)",
              "src": "UT3000 manual"
            },
            "C": {
              "fn": "Common",
              "desc": "System common.",
              "exp": "0 V reference",
              "src": "UT3000 manual"
            }
          }
        },
        "out": {
          "title": "COMM HVAC OUTPUT",
          "silk": {
            "W": "C",
            "Y": "2",
            "G": "1",
            "R": "R"
          },
          "terminals": {
            "W": {
              "fn": "C · Common",
              "desc": "Board terminal W carries Common to the communicating indoor unit.",
              "exp": "0 V reference",
              "src": "UT3000 manual"
            },
            "R": {
              "fn": "R · 24 VAC",
              "desc": "Board terminal R carries 24 VAC to the communicating indoor unit.",
              "exp": "24 VAC (to C)",
              "src": "UT3000 manual"
            },
            "G": {
              "fn": "1 · Data 1",
              "desc": "Board terminal G carries Data 1 of the HVAC bus. BIAS dip switches #1 and #2 ON.",
              "exp": "2.3 VDC to C (CAPE coil + 2-stage furnace)",
              "alt": "Other systems: 2.8 (or 1.9)",
              "src": "UT3000 manual"
            },
            "Y": {
              "fn": "2 · Data 2",
              "desc": "Board terminal Y carries Data 2. Data 1 − Data 2 = 0.6 VDC.",
              "exp": "1.7 VDC to C (CAPE coil + 2-stage furnace)",
              "alt": "Other systems: 2.2 (or 1.3)",
              "src": "UT3000 manual"
            }
          }
        },
        "oas": {
          "title": "OAS",
          "unusedIn": [
            "communicating"
          ],
          "terminals": {
            "_": {
              "fn": "Outdoor air sensor",
              "desc": "Not needed: the communicating outdoor unit shares outdoor temperature. \"OAS BAD\" on screen = comm network unstable.",
              "exp": "Not used",
              "src": "UT3000 manual"
            }
          }
        },
        "sas": {
          "title": "SAS",
          "terminals": {
            "_": {
              "fn": "Supply air sensor input",
              "desc": "Thermistor input. Default targets: HP 105°F · Gas 142°F · Cool 47°F. \"SAS Sensor Bad\" on screen if faulty.",
              "exp": "≈ 10.5 kΩ at 75°F (see SAS ficha)",
              "src": "SAS sheet"
            }
          }
        }
      },
      "parts": [
        {
          "id": "brk",
          "block": "xfmr",
          "type": "breaker",
          "title": "2.5 A breaker",
          "desc": "Auto-reset over-current protection on the 24 VAC input (yellow, beside T'FORMER).",
          "states": [
            "normal",
            "tripped"
          ],
          "default": "normal",
          "spec": "2.5 A",
          "src": "UT3000 manual"
        },
        {
          "id": "jmp1",
          "block": "sys",
          "type": "jumper",
          "title": "RC/RH jumper · JMP1",
          "desc": "Links RC and RH for the conventional system output. Not used in a communicating install.",
          "states": [
            "installed",
            "removed"
          ],
          "default": "installed",
          "src": "UT3000 manual"
        },
        {
          "id": "dip",
          "block": "out",
          "type": "dip",
          "title": "BIAS / TERMINATION dip switches",
          "desc": "Bottom of the board. #1 and #2 = BIAS for the communicating HVAC bus. #3 = termination.",
          "switches": [
            {
              "n": 1,
              "role": "BIAS",
              "default": "on"
            },
            {
              "n": 2,
              "role": "BIAS",
              "default": "on"
            },
            {
              "n": 3,
              "role": "TERM",
              "default": null,
              "note": "Drawn neutral (decided)"
            }
          ],
          "src": "UT3000 manual"
        },
        {
          "id": "btn",
          "block": null,
          "type": "buttons",
          "title": "4-button programming",
          "desc": "Up / Down / Back / Forward under the LCD. Scroll the menu and make selections. Settings kept in non-volatile memory.",
          "src": "UT3000 manual"
        }
      ],
