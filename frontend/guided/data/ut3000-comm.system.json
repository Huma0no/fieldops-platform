{
  "id": "ut3000-comm",
  "version": "0.1",
  "title": "UT3000 · communicating",
  "setup": "communicating",
  "maxZones": 3,
  "board": { "component": "ut3000" },
  "colors": { "damperCOM": "white", "damperPO": "red", "damperPC": "blue" },
  "boardItems": [
    { "kind": "part", "id": "brk",   "at": "xf",  "label": "2.5 A" },
    { "kind": "part", "id": "jmp1",  "at": "sys", "label": "JMP1" },
    { "kind": "part", "id": "dip",   "at": "out", "label": "DIP" },
    { "kind": "led",  "id": "led22", "at": "out", "label": "LED22" },
    { "kind": "led",  "id": "z3rx",  "at": "z3c", "label": "Z3" },
    { "kind": "led",  "id": "z2rx",  "at": "z2c", "label": "Z2" },
    { "kind": "led",  "id": "z1rx",  "at": "z1c", "label": "Z1" },
    { "kind": "led",  "id": "zo1",   "zone": 1,   "label": "Z1 OPEN" },
    { "kind": "led",  "id": "zo2",   "zone": 2,   "label": "Z2 OPEN" },
    { "kind": "led",  "id": "zo3",   "zone": 3,   "label": "Z3 OPEN" },
    { "kind": "led",  "id": "iaq",   "label": "IAQ" },
    { "kind": "led",  "id": "w2",    "label": "W2 / EM" },
    { "kind": "led",  "id": "heat",  "label": "HEAT" },
    { "kind": "led",  "id": "comp",  "label": "COMP" },
    { "kind": "led",  "id": "fan",   "label": "FAN" },
    { "kind": "part", "id": "btn",   "label": "Buttons" }
  ],
  "blocks": [
    { "id": "d3",  "type": "damper", "zone": 3, "side": "left",  "terminals": ["C", "PC", "PO"] },
    { "id": "z3c", "type": "comm",   "zone": 3, "side": "left",  "terminals": ["C", "2", "1", "R"] },
    { "id": "z3v", "type": "conv",   "zone": 3, "side": "left",  "terminals": ["_"] },
    { "id": "xf",  "type": "xfmr",              "side": "left",  "terminals": ["R", "C"] },
    { "id": "iaq", "type": "iaq",               "side": "left",  "terminals": ["_"] },
    { "id": "sys", "type": "sys",               "side": "left",  "terminals": ["RH", "RC", "C", "_"] },
    { "id": "out", "type": "out",               "side": "left",  "terminals": ["W", "Y", "G", "R"] },
    { "id": "d2",  "type": "damper", "zone": 2, "side": "right", "terminals": ["C", "PC", "PO"] },
    { "id": "z2c", "type": "comm",   "zone": 2, "side": "right", "terminals": ["C", "2", "1", "R"] },
    { "id": "z2v", "type": "conv",   "zone": 2, "side": "right", "terminals": ["_"] },
    { "id": "d1",  "type": "damper", "zone": 1, "side": "right", "terminals": ["C", "PC", "PO"] },
    { "id": "z1c", "type": "comm",   "zone": 1, "side": "right", "terminals": ["C", "2", "1", "R"] },
    { "id": "z1v", "type": "conv",   "zone": 1, "side": "right", "terminals": ["_"] },
    { "id": "oas", "type": "oas",               "side": "right", "terminals": ["_"] },
    { "id": "sas", "type": "sas",               "side": "right", "terminals": ["_"] }
  ],
  "devices": [
    { "id": "damper3", "component": "damper", "zone": 3, "side": "left", "column": "outer", "anchor": "d3",
      "in": ["COM", "PO", "PC"], "labels": { "COM": "1 COM", "PO": "4 PO", "PC": "6 PC" } },
    { "id": "dapc3", "component": "dapc", "zone": 3, "when": { "dapc": true }, "side": "left", "column": "mid", "anchor": "d3",
      "in": ["iCOM", "iPC", "iPO"], "out": ["oCOM", "oPC", "oPO"],
      "labels": { "iCOM": "COM", "iPC": "PC", "iPO": "PO", "oCOM": "COM", "oPC": "PC", "oPO": "PO" } },
    { "id": "tstat3", "component": "tstat", "zone": 3, "side": "left", "column": "outer", "anchor": "z3c",
      "in": ["C", "2", "1", "R"] },
    { "id": "dapcPwr", "component": "dapc", "section": "power", "when": { "dapc": true }, "side": "left", "column": "mid", "anchor": "xf",
      "in": ["R", "C"], "out": ["Rb", "Cb", "SUP", "RET", "DATA"], "unused": ["DATA"],
      "labels": { "Rb": "R", "Cb": "C" } },
    { "id": "sbd2", "component": "sbd2", "when": { "dapc": true }, "side": "left", "column": "outer", "anchor": "xf",
      "in": ["2", "1", "P", "M"], "labels": { "2": "2 (+)", "1": "1 (−)", "P": "+ port", "M": "− port" } },
    { "id": "taps", "component": "taps", "when": { "dapc": true }, "side": "left", "column": "outer", "anchor": "xf",
      "in": ["S", "R", "S2", "R2"], "labels": { "S": "Supply", "R": "Return", "S2": "Supply pitot", "R2": "Return pitot" } },
    { "id": "xfmr", "component": "xfmr", "side": "left", "column": "outer", "anchor": "xf",
      "in": ["R", "C"], "labels": { "R": "24V", "C": "COM" } },
    { "id": "furnace", "component": "furnace", "side": "left", "column": "outer", "anchor": "out",
      "in": ["C", "2", "1", "R"] },
    { "id": "coil", "component": "coil", "side": "left", "column": "outer", "anchor": "out",
      "in": ["C", "2", "1", "R"] },
    { "id": "outdoor", "component": "outdoor", "side": "left", "column": "outer", "anchor": "out",
      "in": ["2", "1", "R", "C"], "unused": ["R", "C"] },
    { "id": "damper2", "component": "damper", "zone": 2, "side": "right", "column": "outer", "anchor": "d2",
      "in": ["COM", "PO", "PC"], "labels": { "COM": "1 COM", "PO": "4 PO", "PC": "6 PC" } },
    { "id": "dapc2", "component": "dapc", "zone": 2, "when": { "dapc": true }, "side": "right", "column": "mid", "anchor": "d2",
      "in": ["iCOM", "iPC", "iPO"], "out": ["oCOM", "oPC", "oPO"],
      "labels": { "iCOM": "COM", "iPC": "PC", "iPO": "PO", "oCOM": "COM", "oPC": "PC", "oPO": "PO" } },
    { "id": "tstat2", "component": "tstat", "zone": 2, "side": "right", "column": "outer", "anchor": "z2c",
      "in": ["C", "2", "1", "R"] },
    { "id": "damper1", "component": "damper", "zone": 1, "side": "right", "column": "outer", "anchor": "d1",
      "in": ["COM", "PO", "PC"], "labels": { "COM": "1 COM", "PO": "4 PO", "PC": "6 PC" } },
    { "id": "dapc1", "component": "dapc", "zone": 1, "when": { "dapc": true }, "side": "right", "column": "mid", "anchor": "d1",
      "in": ["iCOM", "iPC", "iPO"], "out": ["oCOM", "oPC", "oPO"],
      "labels": { "iCOM": "COM", "iPC": "PC", "iPO": "PO", "oCOM": "COM", "oPC": "PC", "oPO": "PO" } },
    { "id": "tstat1", "component": "tstat", "zone": 1, "side": "right", "column": "outer", "anchor": "z1c",
      "in": ["C", "2", "1", "R"] },
    { "id": "sensor", "component": "sas", "side": "right", "column": "outer", "anchor": "sas",
      "in": ["a", "b"] }
  ],
  "wireTemplates": {
    "perZone": [
      { "from": "tstat{n}.C", "to": "z{n}c.C", "color": "white" },
      { "from": "tstat{n}.2", "to": "z{n}c.2", "color": "yellow" },
      { "from": "tstat{n}.1", "to": "z{n}c.1", "color": "green" },
      { "from": "tstat{n}.R", "to": "z{n}c.R", "color": "red" },
      { "from": "damper{n}.COM", "to": "d{n}.C",  "color": "damperCOM", "when": { "dapc": false } },
      { "from": "damper{n}.PC",  "to": "d{n}.PC", "color": "damperPC", "when": { "dapc": false } },
      { "from": "damper{n}.PO",  "to": "d{n}.PO", "color": "damperPO", "when": { "dapc": false } },
      { "from": "dapc{n}.iCOM", "to": "d{n}.C",  "color": "damperCOM", "when": { "dapc": true } },
      { "from": "dapc{n}.iPC",  "to": "d{n}.PC", "color": "damperPC", "when": { "dapc": true } },
      { "from": "dapc{n}.iPO",  "to": "d{n}.PO", "color": "damperPO", "when": { "dapc": true } },
      { "from": "damper{n}.COM", "to": "dapc{n}.oCOM", "color": "damperCOM", "when": { "dapc": true } },
      { "from": "damper{n}.PC",  "to": "dapc{n}.oPC",  "color": "damperPC", "when": { "dapc": true } },
      { "from": "damper{n}.PO",  "to": "dapc{n}.oPO",  "color": "damperPO", "when": { "dapc": true } }
    ]
  },
  "wires": [
    { "from": "furnace.C", "to": "out.W", "color": "white" },
    { "from": "furnace.2", "to": "out.Y", "color": "yellow" },
    { "from": "furnace.1", "to": "out.G", "color": "green" },
    { "from": "furnace.R", "to": "out.R", "color": "red" },
    { "from": "coil.C", "to": "furnace.C", "color": "white" },
    { "from": "coil.2", "to": "furnace.2", "color": "yellow" },
    { "from": "coil.1", "to": "furnace.1", "color": "green" },
    { "from": "coil.R", "to": "furnace.R", "color": "red" },
    { "from": "outdoor.2", "to": "coil.2", "color": "yellow" },
    { "from": "outdoor.1", "to": "coil.1", "color": "green" },
    { "from": "xfmr.R", "to": "xf.R", "color": "red" },
    { "from": "xfmr.C", "to": "xf.C", "color": "blue" },
    { "from": "dapcPwr.R", "to": "xf.R", "color": "red", "when": { "dapc": true } },
    { "from": "dapcPwr.C", "to": "xf.C", "color": "blue", "when": { "dapc": true } },
    { "from": "sbd2.2", "to": "dapcPwr.Rb", "color": "red", "when": { "dapc": true } },
    { "from": "sbd2.1", "to": "dapcPwr.Cb", "color": "blue", "when": { "dapc": true } },
    { "from": "taps.S", "to": "dapcPwr.SUP", "type": "tube", "when": { "dapc": true } },
    { "from": "taps.R", "to": "dapcPwr.RET", "type": "tube", "when": { "dapc": true } },
    { "from": "taps.S2", "to": "sbd2.P", "type": "tube", "when": { "dapc": true } },
    { "from": "taps.R2", "to": "sbd2.M", "type": "tube", "when": { "dapc": true } },
    { "from": "sensor.a", "to": "sas._", "color": "black" },
    { "from": "sensor.b", "to": "sas._", "color": "black" }
  ]
}
