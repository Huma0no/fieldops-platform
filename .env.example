DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fieldops
TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fieldops_test
PORT=3001
# Number of reverse proxies in front of the server (e.g. 1 on a PaaS); leave empty when exposed directly
TRUST_PROXY=
# Initial password for the Dispatcher owner account (min. length enforced; change on first login)
DISPATCH_BOOTSTRAP_PASSWORD=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-drive-key.json
